<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Учёт расходов</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
font-family:system-ui;
background:linear-gradient(135deg,#6b73ff,#000dff);
margin:0;
padding:20px;
display:flex;
justify-content:center;
}

.app{
width:440px;
background:white;
border-radius:22px;
box-shadow:0 15px 40px rgba(0,0,0,0.25);
overflow:hidden;
}

.header{
background:linear-gradient(135deg,#6b73ff,#000dff);
color:white;
padding:26px;
font-size:28px;
font-weight:700;
text-align:center;
}

.tabs{
display:flex;
background:#f3f4f7;
border-bottom:1px solid #eee;
}

.tab{
flex:1;
padding:20px;
font-size:17px;
font-weight:700;
cursor:pointer;
border:none;
background:none;
}

.tab.active{
background:white;
border-bottom:4px solid #6b73ff;
color:#6b73ff;
}

.content{
padding:22px;
}

.page{
display:none;
}

.page.active{
display:block;
}

input{
width:100%;
padding:14px;
margin:10px 0;
border-radius:12px;
border:1px solid #ddd;
font-size:15px;
}

button.add{
width:100%;
padding:14px;
border:none;
border-radius:12px;
background:#6b73ff;
color:white;
font-size:17px;
font-weight:600;
cursor:pointer;
}

.item{
background:white;
box-shadow:0 6px 15px rgba(0,0,0,0.08);
padding:12px;
border-radius:12px;
margin:8px 0;
display:flex;
justify-content:space-between;
}

.chart-box{
max-width:260px;
margin:auto;
}

.month{
background:#f4f6fb;
padding:15px;
border-radius:14px;
margin-bottom:12px;
}

.toast{
position:fixed;
bottom:20px;
left:50%;
transform:translateX(-50%) translateY(100px);
background:#2ecc71;
color:white;
padding:15px 24px;
border-radius:12px;
font-size:16px;
box-shadow:0 10px 25px rgba(0,0,0,0.25);
opacity:0;
transition:all .4s;
}

.toast.show{
opacity:1;
transform:translateX(-50%) translateY(0);
}

</style>
</head>

<body>

<div class="app">

<div class="header">
💰 Учёт расходов
</div>

<div class="tabs">
<button class="tab active" onclick="openTab(0)">Добавить</button>
<button class="tab" onclick="openTab(1)">Статистика</button>
<button class="tab" onclick="openTab(2)">История</button>
<button class="tab" onclick="openTab(3)">Месяцы</button>
</div>

<div class="content">

<!-- Добавить -->

<div class="page active">

<input id="name" placeholder="Категория расхода">
<input id="amount" type="number" placeholder="Сумма">

<button class="add" onclick="addExpense()">Добавить расход</button>

</div>

<!-- Статистика -->

<div class="page">

<h3 style="text-align:center;">Круговая диаграмма расходов</h3>

<div class="chart-box">
<canvas id="pieChart"></canvas>
</div>

</div>

<!-- История -->

<div class="page">
<div id="history"></div>
</div>

<!-- Месяцы -->

<div class="page">
<h3 style="text-align:center;margin-bottom:15px;">
📅 Расходы по месяцам
</h3>

<div id="months"></div>
</div>

</div>

</div>

<div id="toast" class="toast"></div>

<script>

let expenses=JSON.parse(localStorage.getItem("expenses"))||[];

/* вкладки */

function openTab(index){

document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));

document.querySelectorAll(".page")[index].classList.add("active");
document.querySelectorAll(".tab")[index].classList.add("active");

}

/* диаграмма */

const pieCtx=document.getElementById("pieChart");

const pieChart=new Chart(pieCtx,{
type:"pie",
data:{
labels:[],
datasets:[{
data:[],
backgroundColor:[
"#6b73ff",
"#f6ad55",
"#fc8181",
"#68d391",
"#63b3ed",
"#ed64a6"
]
}]
}
});

/* обновление */

function update(){

pieChart.data.labels=expenses.map(e=>e.name);
pieChart.data.datasets[0].data=expenses.map(e=>e.amount);
pieChart.update();

const history=document.getElementById("history");
history.innerHTML="";

expenses.slice().reverse().forEach(e=>{

const div=document.createElement("div");
div.className="item";
div.innerHTML=`<span>${e.name}</span><b>${e.amount} ₽</b>`;

history.appendChild(div);

});

renderMonths();

localStorage.setItem("expenses",JSON.stringify(expenses));

}

/* месяцы */

function renderMonths(){

const container=document.getElementById("months");

if(!container)return;

const months={};

expenses.forEach(e=>{

const d=new Date(e.date);

const key=d.getFullYear()+"-"+(d.getMonth()+1);

if(!months[key])months[key]=[];

months[key].push(e);

});

container.innerHTML="";

Object.keys(months).sort().reverse().forEach(m=>{

let total=0;

months[m].forEach(e=>total+=e.amount);

const block=document.createElement("div");

block.className="month";

let html=`<b>${m}</b><br><br>`;

months[m].forEach(e=>{
html+=`${e.name} — ${e.amount} ₽<br>`;
});

html+=`<br><b>Итого: ${total} ₽</b>`;

block.innerHTML=html;

container.appendChild(block);

});

}

/* уведомление */

function toast(text){

const t=document.getElementById("toast");

t.textContent=text;
t.classList.add("show");

setTimeout(()=>{
t.classList.remove("show");
},2500);

}

/* добавление */

function addExpense(){

const name=document.getElementById("name").value;
const amount=document.getElementById("amount").value;

if(!name||!amount)return;

expenses.push({
name:name,
amount:Number(amount),
date:new Date().toISOString()
});

document.getElementById("name").value="";
document.getElementById("amount").value="";

update();

toast("💰 Расход добавлен");

}

update();

</script>

</body>
</html>
