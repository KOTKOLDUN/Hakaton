<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Expense Tracker</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
font-family:Arial;
background:linear-gradient(135deg,#667eea,#764ba2);
margin:0;
padding:20px;
}

.container{
max-width:900px;
margin:auto;
background:white;
border-radius:20px;
padding:30px;
box-shadow:0 20px 50px rgba(0,0,0,0.3);
}

h1{
text-align:center;
margin-bottom:30px;
}

.menu{
display:flex;
gap:10px;
justify-content:center;
flex-wrap:wrap;
margin-bottom:30px;
}

.menu button{
padding:10px 20px;
border:none;
border-radius:20px;
cursor:pointer;
background:#eee;
font-size:16px;
}

.menu button.active{
background:#667eea;
color:white;
}

.section{
display:none;
}

.section.active{
display:block;
}

input,select,textarea{
width:100%;
padding:10px;
margin-bottom:15px;
border-radius:8px;
border:1px solid #ddd;
font-size:16px;
}

button.main{
background:#667eea;
color:white;
border:none;
padding:12px;
width:100%;
border-radius:20px;
cursor:pointer;
font-size:16px;
}

button.main:hover{
opacity:0.9;
}

table{
width:100%;
border-collapse:collapse;
}

th,td{
padding:10px;
border-bottom:1px solid #eee;
text-align:left;
}

.delete{
background:#ff4d4d;
color:white;
border:none;
padding:5px 10px;
border-radius:5px;
cursor:pointer;
}

.total{
font-size:22px;
text-align:center;
margin:20px 0;
font-weight:bold;
}

/* уменьшенная диаграмма */

.chart-box{
width:280px;
height:280px;
margin:auto;
}

@media(max-width:600px){

.container{
padding:15px;
}

table{
font-size:14px;
}

.chart-box{
width:220px;
height:220px;
}

}

</style>
</head>

<body>

<div class="container">

<h1>💰 Трекер расходов</h1>

<div class="menu">

<button onclick="show(event,'add')" class="active">➕ Добавить</button>
<button onclick="show(event,'list')">📋 Список</button>
<button onclick="show(event,'stats')">📊 Статистика</button>

</div>

<div id="add" class="section active">

<input id="amount" type="number" placeholder="Сумма">

<select id="category">

<option>🍔 Еда</option>
<option>🚕 Транспорт</option>
<option>🎮 Игры</option>
<option>🎬 Развлечения</option>
<option>🛒 Покупки</option>
<option>💊 Здоровье</option>
<option>📱 Связь</option>

</select>

<input id="date" type="date">

<textarea id="desc" placeholder="Описание"></textarea>

<button class="main" onclick="addExpense()">Добавить расход</button>

</div>

<div id="list" class="section">

<div class="total">
Всего: <span id="total">0</span> ₽
</div>

<table>

<thead>
<tr>
<th>Дата</th>
<th>Категория</th>
<th>Сумма</th>
<th></th>
</tr>
</thead>

<tbody id="table"></tbody>

</table>

</div>

<div id="stats" class="section">

<div class="chart-box">
<canvas id="chart"></canvas>
</div>

</div>

</div>

<script>

let expenses=JSON.parse(localStorage.getItem("expenses"))||[]

function save(){

localStorage.setItem("expenses",JSON.stringify(expenses))

}

function show(e,id){

document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"))
document.getElementById(id).classList.add("active")

document.querySelectorAll(".menu button").forEach(b=>b.classList.remove("active"))
e.target.classList.add("active")

if(id==="list")updateList()
if(id==="stats")updateStats()

}

function addExpense(){

let amount=document.getElementById("amount").value
let category=document.getElementById("category").value
let desc=document.getElementById("desc").value
let date=document.getElementById("date").value

if(!amount){

alert("Введите сумму")
return

}

expenses.push({

id:Date.now(),
amount:Number(amount),
category,
desc,
date

})

save()

document.getElementById("amount").value=""
document.getElementById("desc").value=""

updateList()

alert("Расход добавлен")

}

function deleteExpense(id){

expenses=expenses.filter(e=>e.id!==id)

save()

updateList()
updateStats()

}

function updateList(){

let table=document.getElementById("table")
let total=0
let html=""

expenses.forEach(e=>{

total+=e.amount

html+=`
<tr>

<td>${e.date||"-"}</td>
<td>${e.category}</td>
<td>${e.amount} ₽</td>

<td>
<button class="delete" onclick="deleteExpense(${e.id})">
✖
</button>
</td>

</tr>
`

})

table.innerHTML=html
document.getElementById("total").textContent=total

}

let chart

function updateStats(){

let cats={}

expenses.forEach(e=>{

if(!cats[e.category])cats[e.category]=0

cats[e.category]+=e.amount

})

let labels=Object.keys(cats)
let data=Object.values(cats)

if(chart) chart.destroy()

chart=new Chart(document.getElementById("chart"),{

type:"pie",

data:{

labels:labels,

datasets:[{

data:data

}]

}

})

}

updateList()

</script>

</body>
</html>
