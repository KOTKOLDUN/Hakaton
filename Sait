<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Трекер расходов</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 2.5em;
        }

        h1 span {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .menu {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 30px;
            justify-content: center;
        }

        .menu-btn {
            padding: 12px 25px;
            border: none;
            border-radius: 25px;
            background: #f0f0f0;
            color: #333;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
            border: 2px solid transparent;
        }

        .menu-btn:hover {
            background: #e0e0e0;
            transform: translateY(-2px);
        }

        .menu-btn.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .section {
            display: none;
        }

        .section.active {
            display: block;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            color: #555;
            font-weight: 500;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            transition: 0.3s;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #667eea;
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 25px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
            width: 100%;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th {
            background: #f5f5f5;
            padding: 12px;
            text-align: left;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #e0e0e0;
        }

        .expense-row:hover {
            background: #f9f9f9;
        }

        .delete-btn {
            background: #ff4757;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        .delete-btn:hover {
            background: #ff6b81;
        }

        .total {
            font-size: 1.5em;
            text-align: center;
            margin: 20px 0;
            padding: 20px;
            background: #f5f5f5;
            border-radius: 10px;
        }

        .total span {
            color: #667eea;
            font-weight: bold;
            font-size: 1.3em;
        }

        .chart-container {
            margin: 20px 0;
        }

        .chart-item {
            margin: 15px 0;
        }

        .chart-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
        }

        .chart-bar {
            height: 30px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            transition: width 0.3s;
            min-width: 4px;
        }

        .category-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 20px 0;
        }

        .category-pill {
            padding: 8px 15px;
            background: #f0f0f0;
            border-radius: 20px;
            cursor: pointer;
            transition: 0.3s;
        }

        .category-pill:hover {
            background: #e0e0e0;
        }

        .category-pill.active {
            background: #667eea;
            color: white;
        }

        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 15px 25px;
            border-radius: 10px;
            color: white;
            animation: slideIn 0.3s;
            z-index: 1000;
        }

        .notification.success {
            background: #00d25b;
        }

        .notification.error {
            background: #ff4757;
        }

        .notification.info {
            background: #667eea;
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .summary-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 15px;
            text-align: center;
        }

        .summary-card h3 {
            font-size: 1em;
            margin-bottom: 10px;
            opacity: 0.9;
        }

        .summary-card .value {
            font-size: 1.8em;
            font-weight: bold;
        }

        .export-btn {
            background: #4CAF50;
            margin-top: 20px;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #999;
        }

        .empty-state img {
            width: 100px;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        @media (max-width: 600px) {
            .container {
                padding: 15px;
            }
            
            table {
                font-size: 14px;
            }
            
            td, th {
                padding: 8px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>💰 <span>Трекер расходов</span></h1>
        
        <!-- Меню -->
        <div class="menu">
            <button class="menu-btn active" onclick="showSection('add')">➕ Добавить</button>
            <button class="menu-btn" onclick="showSection('list')">📋 Список</button>
            <button class="menu-btn" onclick="showSection('stats')">📊 Статистика</button>
            <button class="menu-btn" onclick="showSection('categories')">📁 Категории</button>
        </div>

        <!-- Секция добавления -->
        <div id="addSection" class="section active">
            <h2>Добавить новый расход</h2>
            
            <div class="form-group">
                <label>Сумма (₽)</label>
                <input type="number" id="amount" placeholder="Например: 500" min="0.01" step="0.01">
            </div>

            <div class="form-group">
                <label>Категория</label>
                <select id="category">
                    <option value="🍔 Еда">🍔 Еда</option>
                    <option value="🚇 Транспорт">🚇 Транспорт</option>
                    <option value="🎬 Развлечения">🎬 Развлечения</option>
                    <option value="🏠 Жильё">🏠 Жильё</option>
                    <option value="📚 Образование">📚 Образование</option>
                    <option value="🛍️ Покупки">🛍️ Покупки</option>
                    <option value="💊 Здоровье">💊 Здоровье</option>
                    <option value="📱 Связь">📱 Связь</option>
                    <option value="✈️ Путешествия">✈️ Путешествия</option>
                    <option value="💼 Прочее">💼 Прочее</option>
                </select>
            </div>

            <div class="form-group">
                <label>Описание</label>
                <textarea id="description" placeholder="Что купили?" rows="3"></textarea>
            </div>

            <button class="btn" onclick="addExpense()">💾 Сохранить расход</button>
        </div>

        <!-- Секция списка -->
        <div id="listSection" class="section">
            <h2>Все расходы</h2>
            
            <div class="total" id="totalAmount">
                Всего: <span>0 ₽</span>
            </div>

            <table id="expensesTable">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Категория</th>
                        <th>Сумма</th>
                        <th>Описание</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="expensesList"></tbody>
            </table>

            <button class="btn export-btn" onclick="exportToCSV()" style="margin-top: 20px;">
                📥 Экспорт в CSV
            </button>
        </div>

        <!-- Секция статистики -->
        <div id="statsSection" class="section">
            <h2>Статистика расходов</h2>

            <div class="summary-cards" id="summaryCards">
                <div class="summary-card">
                    <h3>Всего</h3>
                    <div class="value" id="statsTotal">0 ₽</div>
                </div>
                <div class="summary-card">
                    <h3>Средний чек</h3>
                    <div class="value" id="statsAvg">0 ₽</div>
                </div>
                <div class="summary-card">
                    <h3>Кол-во трат</h3>
                    <div class="value" id="statsCount">0</div>
                </div>
            </div>

            <div class="chart-container" id="statsChart"></div>
        </div>

        <!-- Секция категорий -->
        <div id="categoriesSection" class="section">
            <h2>Управление категориями</h2>

            <div class="form-group">
                <label>Новая категория</label>
                <div style="display: flex; gap: 10px;">
                    <input type="text" id="newCategory" placeholder="Например: 🎮 Игры" style="flex: 1;">
                    <button class="btn" onclick="addCategory()" style="width: auto;">➕ Добавить</button>
                </div>
            </div>

            <h3 style="margin: 20px 0;">Существующие категории</h3>
            <div id="categoriesList" class="category-pills"></div>
        </div>
    </div>

    <script>
        // ========== ДАННЫЕ ==========
        let expenses = JSON.parse(localStorage.getItem('expenses')) || [];
        let categories = JSON.parse(localStorage.getItem('categories')) || [
            "🍔 Еда", "🚇 Транспорт", "🎬 Развлечения", "🏠 Жильё",
            "📚 Образование", "🛍️ Покупки", "💊 Здоровье", "📱 Связь",
            "✈️ Путешествия", "💼 Прочее"
        ];

        // ========== СОХРАНЕНИЕ ==========
        function saveData() {
            localStorage.setItem('expenses', JSON.stringify(expenses));
            localStorage.setItem('categories', JSON.stringify(categories));
            updateSelects();
        }

        // ========== УВЕДОМЛЕНИЯ ==========
        function showNotification(message, type = 'success') {
            const notif = document.createElement('div');
            notif.className = `notification ${type}`;
            notif.textContent = message;
            document.body.appendChild(notif);

            setTimeout(() => {
                notif.remove();
            }, 2000);
        }

        // ========== ПЕРЕКЛЮЧЕНИЕ СЕКЦИЙ ==========
        function showSection(section) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.menu-btn').forEach(b => b.classList.remove('active'));
            
            document.getElementById(section + 'Section').classList.add('active');
            event.target.classList.add('active');

            if (section === 'list') updateList();
            if (section === 'stats') updateStats();
            if (section === 'categories') updateCategoriesList();
        }

        // ========== ДОБАВЛЕНИЕ РАСХОДА ==========
        function addExpense() {
            const amount = document.getElementById('amount').value;
            const category = document.getElementById('category').value;
            const description = document.getElementById('description').value;

            if (!amount || amount <= 0) {
                showNotification('Введите сумму!', 'error');
                return;
            }

            const expense = {
                id: Date.now(),
                amount: parseFloat(amount),
                category: category,
                description: description,
                date: new Date().toLocaleDateString('ru-RU')
            };

            expenses.push(expense);
            saveData();

            // Очистка формы
            document.getElementById('amount').value = '';
            document.getElementById('description').value = '';

            showNotification('✅ Расход добавлен!');
            updateList();
            updateStats();
        }

        // ========== УДАЛЕНИЕ РАСХОДА ==========
        function deleteExpense(id) {
            if (confirm('Удалить расход?')) {
                expenses = expenses.filter(e => e.id !== id);
                saveData();
                updateList();
                updateStats();
                showNotification('🗑️ Расход удалён', 'info');
            }
        }

        // ========== ОБНОВЛЕНИЕ СПИСКА ==========
        function updateList() {
            const list = document.getElementById('expensesList');
            const totalEl = document.getElementById('totalAmount').querySelector('span');

            if (expenses.length === 0) {
                list.innerHTML = `
                    <tr>
                        <td colspan="5" class="empty-state">
                            Нет расходов. Добавьте первый расход!
                        </td>
                    </tr>
                `;
                totalEl.textContent = '0 ₽';
                return;
            }

            let total = 0;
            let html = '';

            // Сортировка по дате (сначала новые)
            const sorted = [...expenses].sort((a, b) => b.id - a.id);

            sorted.forEach(exp => {
                total += exp.amount;
                html += `
                    <tr class="expense-row">
                        <td>${exp.date}</td>
                        <td>${exp.category}</td>
                        <td><strong>${exp.amount.toFixed(2)} ₽</strong></td>
                        <td>${exp.description || '-'}</td>
                        <td>
                            <button class="delete-btn" onclick="deleteExpense(${exp.id})">✕</button>
                        </td>
                    </tr>
                `;
            });

            list.innerHTML = html;
            totalEl.textContent = total.toFixed(2) + ' ₽';
        }

        // ========== ОБНОВЛЕНИЕ СТАТИСТИКИ ==========
        function updateStats() {
            if (expenses.length === 0) {
                document.getElementById('statsTotal').textContent = '0 ₽';
                document.getElementById('statsAvg').textContent = '0 ₽';
                document.getElementById('statsCount').textContent = '0';
                document.getElementById('statsChart').innerHTML = 
                    '<div class="empty-state">Нет данных для статистики</div>';
                return;
            }

            // Подсчёты
            let total = 0;
            const categories = {};

            expenses.forEach(exp => {
                total += exp.amount;
                if (!categories[exp.category]) {
                    categories[exp.category] = 0;
                }
                categories[exp.category] += exp.amount;
            });

            const avg = total / expenses.length;
            const maxAmount = Math.max(...Object.values(categories));

            // Обновляем карточки
            document.getElementById('statsTotal').textContent = total.toFixed(2) + ' ₽';
            document.getElementById('statsAvg').textContent = avg.toFixed(2) + ' ₽';
            document.getElementById('statsCount').textContent = expenses.length;

            // Рисуем график
            let chartHtml = '<h3 style="margin-bottom: 20px;">Распределение по категориям</h3>';
            
            const sortedCats = Object.entries(categories).sort((a, b) => b[1] - a[1]);

            sortedCats.forEach(([category, amount]) => {
                const percent = (amount / total * 100).toFixed(1);
                const barWidth = (amount / maxAmount) * 100;

                chartHtml += `
                    <div class="chart-item">
                        <div class="chart-label">
                            <span><strong>${category}</strong></span>
                            <span>${amount.toFixed(2)} ₽ (${percent}%)</span>
                        </div>
                        <div class="chart-bar" style="width: ${barWidth}%"></div>
                    </div>
                `;
            });

            document.getElementById('statsChart').innerHTML = chartHtml;
        }

        // ========== ОБНОВЛЕНИЕ КАТЕГОРИЙ ==========
        function updateCategoriesList() {
            const list = document.getElementById('categoriesList');
            let html = '';

            categories.forEach(cat => {
                html += `<span class="category-pill" onclick="deleteCategory('${cat}')">${cat} ✕</span>`;
            });

            list.innerHTML = html;
            updateSelects();
        }

        function addCategory() {
            const newCat = document.getElementById('newCategory').value.trim();
            if (newCat && !categories.includes(newCat)) {
                categories.push(newCat);
                saveData();
                updateCategoriesList();
                document.getElementById('newCategory').value = '';
                showNotification('✅ Категория добавлена');
            }
        }

        function deleteCategory(category) {
            if (confirm(`Удалить категорию "${category}"?`)) {
                categories = categories.filter(c => c !== category);
                saveData();
                updateCategoriesList();
                showNotification('🗑️ Категория удалена', 'info');
            }
        }

        function updateSelects() {
            const selects = document.querySelectorAll('select');
            const options = categories.map(c => `<option value="${c}">${c}</option>`).join('');
            
            selects.forEach(select => {
                const current = select.value;
                select.innerHTML = options;
                if (categories.includes(current)) {
                    select.value = current;
                }
            });
        }

        // ========== ЭКСПОРТ В CSV ==========
        function exportToCSV() {
            if (expenses.length === 0) {
                showNotification('Нет данных для экспорта', 'erro
