<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Expenses Tracker</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
font-family:system-ui;
background:linear-gradient(135deg,#667eea,#764ba2);
margin:0;
padding:20px;
display:flex;
justify-content:center;
}

.app{
width:420px;
background:white;
border-radius:20px;
box-shadow:0 15px 40px rgba(0,0,0,0.2);
overflow:hidden;
}

/* header */

.header{
background:#667eea;
color:white;
padding:20px;
font-size:22px;
font-weight:bold;
text-align:center;
}

/* tabs */

.tabs{
display:flex;
background:#f1f1f1;
}

.tab{
flex:1;
padding:12px;
cursor:pointer;
border:none;
background:none;
font-weight:600;
}

.tab.active{
background:white;
border-bottom:3px solid #667eea;
}

/* content */

.content{
padding:20px;
}

.page{
display:none;
}

.page.active{
display:block;
}

/* inputs */

input{
width:100%;
padding:12px;
margin:8px 0;
border-radius:10px;
border:1px solid #ddd;
font-size:14px;
}

button.add{
width:100%;
padding:12px;
border:none;
border-radius:10px;
background:#667eea;
color:white;
font-size:16px;
cursor:pointer;
margin-top:10px;
}

button.add:hover{
background:#5a67d8;
}

/* history */

.item{
background:#f5f5f5;
padding:10px;
border-radius:10px;
margin:6px 0;
display:flex;
justify-content:space-between;
}

/* chart */

canvas{
max-width:260px;
margin:auto;
display:block;
}

/* toast */

.toast{
position:fixed;
bottom:20px;
left:50%;
transform:translateX(-50%) translateY(100px);
background:#2ecc71;
color:white;
padding:14px 22px;
border-radius:12px;
box-shadow:0 8px 20px rgba(0,0,0,0.2);
opacity:0;
transition:all .4s;
}

.toast.show{
opacity:1;
transform:translateX(-50%) translateY(0);
}

</style>
</head>

<body>

<div class="app">

<div class="header">
💰 Expenses Tracker
</div>

<div class="tabs">
<button class="tab active" onclick="openTab(0)">Добавить</button>
<button class="tab" onclick="openTab(1)">Статистика</button>
<button class="tab" onclick="openTab(2)">История</button>
</div>

<div class="content">

<!-- add -->

<div class="page active">

<input id="name" placeholder="Категория">
<input id="amount" type="number" placeholder="Сумма">

<button class="add" onclick="addExpense()">Добавить расход</button>

</div>

<!-- stats -->

<div class="page">

<canvas id="chart"></canvas>

</div>

<!-- history -->

<div class="page">

<div id="history"></div>

</div>

</div>

</div>

<div id="toast" class="toast"></div>

<script>

let expenses = JSON.parse(localStorage.getItem("expenses")) || [];

/* tabs */

function openTab(index){

document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));

document.querySelectorAll(".page")[index].classList.add("active");
document.querySelectorAll(".tab")[index].classList.add("active");

}

/* chart */

const ctx=document.getElementById("chart");

const chart=new Chart(ctx,{
type:"doughnut",
data:{
labels:[],
datasets:[{
data:[],
backgroundColor:[
"#667eea",
"#f6ad55",
"#fc8181",
"#68d391",
"#63b3ed"
]
}]
}
});

/* update */

function update(){

chart.data.labels=expenses.map(e=>e.name);
chart.data.datasets[0].data=expenses.map(e=>e.amount);
chart.update();

const history=document.getElementById("history");
history.innerHTML="";

expenses.forEach(e=>{

const div=document.createElement("div");
div.className="item";
div.innerHTML=`<span>${e.name}</span><b>${e.amount}€</b>`;

history.appendChild(div);

});

localStorage.setItem("expenses",JSON.stringify(expenses));

}

/* toast */

function toast(text){

const t=document.getElementById("toast");

t.textContent=text;
t.classList.add("show");

setTimeout(()=>{
t.classList.remove("show");
},2500);

}

/* add */

function addExpense(){

const name=document.getElementById("name").value;
const amount=document.getElementById("amount").value;

if(!name||!amount)return;

expenses.push({
name:name,
amount:Number(amount)
});

document.getElementById("name").value="";
document.getElementById("amount").value="";

update();

toast("💰 Расход добавлен");

}

update();

</script>

</body>
</html>
